@startuml Diagrama_Classes_Moeda_Estudantil
!theme plain
title MeritCoin — Diagrama de Classes (atualizado Lab04S01)
skinparam classAttributeIconSize 0
skinparam linetype ortho

abstract class Usuario {
  - id: UUID
  - email: String
  - passwordHash: String
  - role: Role
  - active: boolean
}

class StudentProfile {
  - fullName: String
  - cpf: String
  - rg: String
  - endereco: Endereco
  - balance: int
  --
  + resgatarVantagem(v: Reward): Redemption
}

class TeacherProfile {
  - fullName: String
  - cpf: String
  - balance: int
  --
  + enviarMoedas(a: StudentProfile, valor: int, msg: String): CoinTransfer
}

class CompanyProfile {
  - tradeName: String
  - cnpj: String
  --
  + cadastrarVantagem(...): Reward
}

class Endereco {
  - street: String
  - number: String
  - complement: String
  - district: String
  - city: String
  - state: String
  - zipCode: String
}

class Institution {
  - id: UUID
  - name: String
}

class Course {
  - id: UUID
  - name: String
}

class Department {
  - id: UUID
  - name: String
}

class Reward {
  - title: String
  - description: String
  - imageUrl: String
  - costCoins: int
  - active: boolean
}

class CoinTransfer {
  - amount: int
  - message: String
  - createdAt: DateTime
}

class WalletTransaction {
  - type: WalletTxType
  - amount: int
  - balanceAfter: int
  - description: String
}

class Redemption {
  - couponCode: String
  - costCoins: int
  - status: CouponStatus
}

class TeacherSemesterCredit {
  - semester: String
  - amount: int
}

class EmailOutbox {
  - toEmail: String
  - subject: String
  - htmlBody: String
  - status: EmailOutboxStatus
}

class Notification {
  - title: String
  - body: String
  - read: boolean
}

class AuthService {
  + login()
  + registerStudent()
  + registerCompany()
}

class WalletsService {
  + ensureSemesterCredit()
  + transfer()
  + myStatement()
}

class RewardsService {
  + create()
  + redeem()
  + confirmCoupon()
}

class EmailService {
  + enqueue()
  + flushOne()
}

Usuario <|-- StudentProfile
Usuario <|-- TeacherProfile
Usuario <|-- CompanyProfile

StudentProfile *--> Endereco
StudentProfile --> Institution
StudentProfile --> Course
TeacherProfile --> Institution
TeacherProfile --> Department
CompanyProfile --> Reward

CoinTransfer --> TeacherProfile
CoinTransfer --> StudentProfile
WalletTransaction --> TeacherProfile
WalletTransaction --> StudentProfile
Redemption --> StudentProfile
Redemption --> Reward
TeacherSemesterCredit --> TeacherProfile
Notification --> Usuario
EmailOutbox --> Usuario

AuthService ..> Usuario
WalletsService ..> TeacherProfile
WalletsService ..> StudentProfile
WalletsService ..> CoinTransfer
WalletsService ..> EmailService
RewardsService ..> Reward
RewardsService ..> Redemption
RewardsService ..> EmailService

note right of WalletsService
  Implementação NestJS:
  backend/src/wallets
end note

note right of RewardsService
  Implementação NestJS:
  backend/src/rewards
end note

@enduml
