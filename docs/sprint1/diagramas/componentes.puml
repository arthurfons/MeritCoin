@startuml Diagrama_Componentes_Moeda_Estudantil
!theme plain
title MeritCoin — Diagrama de Componentes MVC (Lab04S01)
skinparam componentStyle rectangle

actor "Usuário\n(Aluno / Professor / Empresa)" as User

package "View — React/Vite SPA" {
  [LoginPage / Register*] as VAuth
  [WalletPage] as VWallet
  [RewardsPage] as VRewards
  [StudentsPage / Dashboard] as VAdmin
}

package "Controller — NestJS /api/v1" {
  [AuthController] as CAuth
  [StudentsController] as CStudents
  [CompaniesController] as CCompanies
  [WalletsController] as CWallets
  [RewardsController] as CRewards
}

package "Model / Services" {
  [AuthService] as SAuth
  [WalletsService] as SWallets
  [RewardsService] as SRewards
  [StudentsService] as SStudents
  [EmailService] as SEmail
}

package "Persistência ORM" {
  [PrismaService] as Prisma
  database "PostgreSQL" as BD
}

cloud "Externo" {
  [SMTP opcional] as SMTP
}

User --> VAuth
User --> VWallet
User --> VRewards
User --> VAdmin

VAuth --> CAuth
VWallet --> CWallets
VRewards --> CRewards
VAdmin --> CStudents
VAdmin --> CCompanies

CAuth --> SAuth
CWallets --> SWallets
CRewards --> SRewards
CStudents --> SStudents
CCompanies --> SStudents

SWallets --> SEmail
SRewards --> SEmail
SAuth --> Prisma
SWallets --> Prisma
SRewards --> Prisma
SStudents --> Prisma
SEmail --> Prisma
Prisma --> BD
SEmail --> SMTP

note bottom of Prisma
  ORM Prisma = estratégia
  de acesso ao BD (Lab03S02)
end note

@enduml
