@startuml MER_Moeda_Estudantil_S02
!theme plain
title MeritCoin — MER Lab03S02 (Aluno + Empresa)
hide circle
skinparam linetype ortho
skinparam classAttributeIconSize 0

entity "User" as user {
  * id : UUID <<PK>>
  --
  * email : VARCHAR <<UK>>
  * passwordHash : VARCHAR
  * role : ENUM
  * active : BOOLEAN
}

entity "StudentProfile" as aluno {
  * id : UUID <<PK>>
  --
  * userId : UUID <<FK,UK>>
  * fullName : VARCHAR
  * cpf : VARCHAR <<UK>>
  * rg : VARCHAR
  * street : VARCHAR
  * number : VARCHAR
  complement : VARCHAR
  * district : VARCHAR
  * city : VARCHAR
  * state : VARCHAR
  * zipCode : VARCHAR
  studentNumber : VARCHAR
  gradeYear : VARCHAR
  * balance : INT
  * institutionId : UUID <<FK>>
  * courseId : UUID <<FK>>
  classId : UUID <<FK>>
}

entity "CompanyProfile" as emp {
  * id : UUID <<PK>>
  --
  * userId : UUID <<FK,UK>>
  * tradeName : VARCHAR
  * cnpj : VARCHAR <<UK>>
}

entity "TeacherProfile" as prof {
  * id : UUID <<PK>>
  --
  * userId : UUID <<FK,UK>>
  * fullName : VARCHAR
  * cpf : VARCHAR <<UK>>
  * balance : INT
  * institutionId : UUID <<FK>>
  * departmentId : UUID <<FK>>
}

entity "Institution" as inst {
  * id : UUID <<PK>>
  --
  * name : VARCHAR <<UK>>
  * active : BOOLEAN
}

entity "Course" as curso {
  * id : UUID <<PK>>
  --
  * name : VARCHAR
  * institutionId : UUID <<FK>>
}

entity "Department" as dept {
  * id : UUID <<PK>>
  --
  * name : VARCHAR
  * institutionId : UUID <<FK>>
}

user ||--o| aluno
user ||--o| emp
user ||--o| prof
inst ||--o{ curso
inst ||--o{ dept
inst ||--o{ aluno
inst ||--o{ prof
curso ||--o{ aluno
dept ||--o{ prof

note right of aluno
  **CRUD Aluno — Sprint 2**
  Create: register / escola
  Read / Update / Soft-delete
end note

note right of emp
  **CRUD Empresa — Sprint 2**
  Create: register público
  Read / Update / Soft-delete
end note

@enduml
